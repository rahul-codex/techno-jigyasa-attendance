# Environment Configuration for Techno Jigyasa Club Attendance System
# Copy this file to .env and configure your environment-specific values.

# Server Port
PORT=5000
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/techno_jigyasa_attendance?schema=public"

# Security & Authentication Secrets
# Generate random 64-char strings for production (e.g., using openssl rand -hex 32)
JWT_SECRET="replace_with_a_secure_jwt_secret_key"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace_with_a_secure_refresh_secret_key"
JWT_REFRESH_EXPIRES_IN="7d"
COOKIE_SECRET="replace_with_a_secure_cookie_secret_key"

# QR Code Cryptographic Signing Secret
QR_SECRET="replace_with_a_secure_qr_signing_secret_key"

# File Upload Configuration
UPLOAD_DIR="uploads/profiles"
MAX_FILE_SIZE_MB=2

# Admin Authentication & Initial Super Admin Configuration (Backend Only)
INITIAL_ADMIN_ID=""
INITIAL_ADMIN_PASSWORD=""
ADMIN_JWT_SECRET="replace_with_a_secure_admin_jwt_secret_key"
ADMIN_JWT_EXPIRES_IN="8h"
